{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-dashboard",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "backend-api",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "main:app", "--port", "8000", "--app-dir", "backend"],
      "port": 8000
    },
    {
      "name": "backend-api-mock",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set DATABASE_URL=sqlite:///./local_dev_mock.db && backend\\.venv\\Scripts\\python.exe -m uvicorn main:app --port 8000 --app-dir backend"
      ],
      "port": 8000
    }
  ]
}
